# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Auth ───────────────────────────────────────────────
# Your chosen app password (you will type this to log in)
APP_PASSWORD=your_password_here

# A long random string used to sign session tokens.
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=your_jwt_secret_here

# ── Supabase ───────────────────────────────────────────
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Google Sheets ──────────────────────────────────────
# The email address of your service account (from Google Cloud)
GOOGLE_SERVICE_ACCOUNT_EMAIL=goals-dashboard@your-project.iam.gserviceaccount.com

# The private key from your service account JSON file.
# Keep the quotes. Replace literal \n with actual newlines if your host requires it.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# Your spreadsheet ID (already in the code, but put it here too as reference)
# SHEET_ID=1QBg3Tpu31Xb_9zLvy6o9A4U_OaVMspJ9J7OAM9CT5uA
